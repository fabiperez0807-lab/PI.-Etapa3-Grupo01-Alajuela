            <assign variable="dias[5]" expression="254"/>
            <assign variable="codigos[6]" expression="&quot;ENL001&quot;"/>
            <assign variable="nombres[6]" expression="&quot;At&#250;n en lata 140g&quot;"/>
            <assign variable="stocks[6]" expression="60"/>
