            <assign variable="dias[6]" expression="560"/>
            <assign variable="codigos[7]" expression="&quot;ENL002&quot;"/>
            <assign variable="nombres[7]" expression="&quot;Frijoles enlatados 400g&quot;"/>
            <assign variable="stocks[7]" expression="14"/>
            <assign variable="minimos[7]" expression="14"/>
            <assign variable="perecedero[7]" expression="true"/>
            <assign variable="dias[7]" expression="448"/>
            <assign variable="codigos[8]" expression="&quot;ENL003&quot;"/>
            <assign variable="nombres[8]" expression="&quot;Sardinas en lata 125g&quot;"/>
            <assign variable="stocks[8]" expression="45"/>
            <assign variable="minimos[8]" expression="15"/>
            <assign variable="perecedero[8]" expression="true"/>
            <assign variable="dias[8]" expression="518"/>
            <assign variable="codigos[9]" expression="&quot;GRA001&quot;"/>
            <assign variable="nombres[9]" expression="&quot;Arroz blanco 1kg&quot;"/>
            <assign variable="stocks[9]" expression="80"/>
            <assign variable="minimos[9]" expression="25"/>
            <assign variable="perecedero[9]" expression="false"/>
            <assign variable="dias[9]" expression="0"/>
            <assign variable="codigos[10]" expression="&quot;GRA002&quot;"/>
            <assign variable="nombres[10]" expression="&quot;Frijoles negros 1kg&quot;"/>
            <assign variable="stocks[10]" expression="18"/>
            <assign variable="minimos[10]" expression="20"/>
            <assign variable="perecedero[10]" expression="false"/>
            <assign variable="dias[10]" expression="0"/>
            <assign variable="codigos[11]" expression="&quot;LIM001&quot;"/>
            <assign variable="nombres[11]" expression="&quot;Detergente en polvo 1kg&quot;"/>
            <assign variable="stocks[11]" expression="30"/>
            <assign variable="minimos[11]" expression="10"/>
            <assign variable="perecedero[11]" expression="false"/>
            <assign variable="dias[11]" expression="0"/>
        </body>
    </function>
</flowgorithm>
