    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="codigos" type="String" array="True" size="100"/>
            <declare name="nombres" type="String" array="True" size="100"/>
            <declare name="categorias" type="String" array="True" size="100"/>
            <declare name="vencimientos" type="String" array="True" size="100"/>
            <declare name="stocks" type="Integer" array="True" size="100"/>
            <declare name="minimos" type="Integer" array="True" size="100"/>
            <declare name="preciosCompra" type="Real" array="True" size="100"/>
            <declare name="preciosVenta" type="Real" array="True" size="100"/>
            <declare name="n" type="Integer" array="False" size=""/>
            <declare name="opcion" type="Integer" array="False" size=""/>
            <assign variable="n" expression="12"/>
            <call expression="cargardatos(codigos,nombres,categorias,stocks,minimos,preciosCompra,preciosVenta,vencimientos)"/>
            <assign variable="opcion" expression="-1"/>
            <while expression="opcion!=0">
                <output expression="&quot;1.Registrar producto&quot;" newline="True"/>
                <output expression="&quot;2.Actualizar stock&quot;" newline="True"/>
                <output expression="&quot;0.Salir&quot;" newline="True"/>
                <output expression="&quot;Seleccione una opcion:&quot;" newline="False"/>
                <input variable="opcion"/>
                <if expression="opcion==1">
                    <then>
                        <assign variable="n" expression="registrarproductos(codigos,nombres,categorias,stocks,minimos,preciosCompra,preciosVenta,vencimientos,n)"/>
                    </then>
                    <else>
                        <if expression="opcion==2">
                            <then>
                                <call expression="actualizarstock(codigos,nombres,stocks,n)"/>
                            </then>
                            <else>
                                <if expression="opcion!=0">
                                    <then>
                                        <output expression="&quot;Error:opcion no valida.&quot;" newline="True"/>
                                    </then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
            <output expression="&quot;Sesi&#243;n finalizada.&quot;" newline="True"/>
        </body>
    </function>
    <function name="actualizarstock" type="None" variable="">
        <parameters>
            <parameter name="codigos" type="String" array="True"/>
            <parameter name="nombres" type="String" array="True"/>
            <parameter name="stocks" type="Integer" array="True"/>
            <parameter name="n" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="codigo" type="String" array="False" size=""/>
            <declare name="idx" type="Integer" array="False" size=""/>
            <declare name="cantidad" type="Integer" array="False" size=""/>
            <declare name="anterior" type="Integer" array="False" size=""/>
            <declare name="codigoValido" type="Boolean" array="False" size=""/>
            <declare name="cancelado" type="Boolean" array="False" size=""/>
            <assign variable="codigoValido" expression="false"/>
            <assign variable="idx" expression="-1"/>
            <output expression="&quot;ACTUALIZAR STOCK&quot;" newline="True"/>
            <assign variable="cancelado" expression="false"/>
            <while expression="codigoValido == false &amp;&amp; cancelado == false">
                <output expression="&quot;Codigo del producto (ENTER para cancelar):&quot;" newline="False"/>
                <input variable="codigo"/>
                <if expression="codigo==&quot;&quot;">
                    <then>
                        <assign variable="cancelado" expression="true"/>
                        <output expression="&quot;Operacion cancelada&quot;" newline="True"/>
                    </then>
                    <else>
                        <assign variable="idx" expression="buscarindice(codigos,n,codigo)"/>
                        <if expression="idx==-1">
                            <then>
                                <output expression="&quot;Error:el codigo ingresado no existe.&quot;" newline="True"/>
                            </then>
                            <else>
                                <assign variable="codigoValido" expression="true"/>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
            <if expression="cancelado==false">
                <then>
                    <output expression="nombres[idx]&amp;&quot; &#8212; stock actual:&quot; &amp; stocks[idx]" newline="True"/>
                    <assign variable="cantidad" expression="0"/>
                    <while expression="cantidad&lt;=0">
                        <output expression="&quot;Cantidad a agregar:&quot;" newline="False"/>
                        <input variable="cantidad"/>
                        <if expression="cantidad&lt;=0">
                            <then>
                                <output expression="&quot;Error:el valor debe ser mayor que 0.&quot;" newline="True"/>
                            </then>
                            <else/>
                        </if>
                    </while>
                    <assign variable="anterior" expression="stocks[idx]"/>
                    <assign variable="stocks[idx]" expression="stocks[idx]+cantidad"/>
                    <output expression="&quot;Stock actualizado: &quot; &amp; anterior &amp; &quot; -&gt; &quot; &amp; stocks[idx]" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
    <function name="buscarindice" type="Integer" variable="idx">
        <parameters>
            <parameter name="codigos" type="String" array="True"/>
            <parameter name="n" type="Integer" array="False"/>
            <parameter name="codigo" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="Equivale a modelo.buscar_producto:devuelve la posicion del codigo o -1 si no existe"/>
            <declare name="idx" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="idx" expression="-1"/>
            <for variable="i" start="0" end="n - 1" direction="inc" step="1">
                <if expression="codigos[i]==codigo">
                    <then>
                        <assign variable="idx" expression="i"/>
                    </then>
                    <else/>
                </if>
            </for>
        </body>
    </function>
