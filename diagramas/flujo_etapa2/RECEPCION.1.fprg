    <function name="registrarproductos" type="Integer" variable="nuevoN">
        <parameters>
            <parameter name="codigos" type="String" array="True"/>
            <parameter name="nombres" type="String" array="True"/>
            <parameter name="categorias" type="String" array="True"/>
            <parameter name="stocks" type="Integer" array="True"/>
            <parameter name="minimos" type="Integer" array="True"/>
            <parameter name="preciosCompra" type="Real" array="True"/>
            <parameter name="preciosVenta" type="Real" array="True"/>
            <parameter name="vencimientos" type="String" array="True"/>
            <parameter name="n" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="nuevoN" type="Integer" array="False" size=""/>
            <declare name="idx" type="Integer" array="False" size=""/>
            <declare name="codigo" type="String" array="False" size=""/>
            <declare name="nombre" type="String" array="False" size=""/>
            <declare name="categoria" type="String" array="False" size=""/>
            <declare name="vence" type="String" array="False" size=""/>
            <declare name="stock" type="Integer" array="False" size=""/>
            <declare name="minimo" type="Integer" array="False" size=""/>
            <declare name="compra" type="Real" array="False" size=""/>
            <declare name="venta" type="Real" array="False" size=""/>
            <declare name="codigoValido" type="Boolean" array="False" size=""/>
            <declare name="fechaValida" type="Boolean" array="False" size=""/>
            <assign variable="nuevoN" expression="0"/>
            <output expression="&quot;REGISTRAR PRODUCTO&quot;" newline="True"/>
            <assign variable="codigoValido" expression="false"/>
            <while expression="codigoValido == false">
                <output expression="&quot;C&#243;digo del producto: &quot;" newline="False"/>
                <input variable="codigo"/>
                <if expression="codigo == &quot;&quot;">
                    <then>
                        <output expression="&quot;Error: este campo es obligatorio y no puede quedar vac&#237;o.&quot;" newline="True"/>
                    </then>
                    <else>
                        <assign variable="idx" expression="buscarindice(codigos, n, codigo)"/>
                        <if expression="idx != -1">
                            <then>
                                <output expression="&quot;Error: el c&#243;digo &quot; &amp; codigo &amp; &quot; ya existe en el cat&#225;logo.&quot;" newline="True"/>
                            </then>
                            <else>
                                <assign variable="codigoValido" expression="true"/>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
            <assign variable="nombre" expression="&quot;&quot;"/>
            <while expression="nombre == &quot;&quot;">
                <output expression="&quot;Nombre: &quot;" newline="False"/>
                <input variable="nombre"/>
                <if expression="nombre == &quot;&quot;">
                    <then>
                        <output expression="&quot;Error: este campo es obligatorio y no puede quedar vac&#237;o.&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
            </while>
            <assign variable="categoria" expression="&quot;&quot;"/>
            <while expression="categoria == &quot;&quot;">
                <output expression="&quot;Categor&#237;a: &quot;" newline="False"/>
                <input variable="categoria"/>
                <if expression="categoria == &quot;&quot;">
                    <then>
                        <output expression="&quot;Error: este campo es obligatorio y no puede quedar vac&#237;o.&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
            </while>
            <assign variable="stock" expression="0"/>
            <while expression="stock &lt;= 0">
                <output expression="&quot;Stock inicial (unidades): &quot;" newline="False"/>
                <input variable="stock"/>
                <if expression="stock &lt;= 0">
                    <then>
                        <output expression="&quot;Error: el valor debe ser mayor que 0.&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
            </while>
            <assign variable="minimo" expression="0"/>
            <while expression="minimo &lt;= 0">
                <output expression="&quot;Stock m&#237;nimo (unidades): &quot;" newline="False"/>
                <input variable="minimo"/>
                <if expression="minimo &lt;= 0">
                    <then>
                        <output expression="&quot;Error: el valor debe ser mayor que 0.&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
            </while>
            <assign variable="compra" expression="0"/>
            <while expression="compra &lt;= 0">
                <output expression="&quot;Precio de compra: &quot;" newline="False"/>
                <input variable="compra"/>
                <if expression="compra &lt;= 0">
                    <then>
                        <output expression="&quot;Error: el valor debe ser mayor que 0.&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
            </while>
            <assign variable="venta" expression="0"/>
            <while expression="venta &lt;= 0">
                <output expression="&quot;Precio de venta: &quot;" newline="False"/>
                <input variable="venta"/>
                <if expression="venta &lt;= 0">
                    <then>
                        <output expression="&quot;Error: el valor debe ser mayor que 0.&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
            </while>
            <assign variable="fechaValida" expression="false"/>
            <comment text="Python valida adem&#225;s que sea una fecha real; aqu&#237; se comprueba el formato por longitud"/>
            <while expression="fechaValida == false">
                <output expression="&quot;Fecha de vencimiento YYYY-MM-DD (ENTER si no aplica): &quot;" newline="False"/>
                <input variable="vence"/>
                <if expression="vence == &quot;&quot; || Len(vence) == 10">
                    <then>
                        <assign variable="fechaValida" expression="true"/>
                    </then>
                    <else>
                        <output expression="&quot;Error: formato inv&#225;lido. Use YYYY-MM-DD (por ejemplo 2026-12-31).&quot;" newline="True"/>
                    </else>
                </if>
            </while>
            <assign variable="codigos[n]" expression="codigo"/>
            <assign variable="nombres[n]" expression="nombre"/>
            <assign variable="categorias[n]" expression="categoria"/>
            <assign variable="stocks[n]" expression="stock"/>
            <assign variable="minimos[n]" expression="minimo"/>
            <assign variable="preciosCompra[n]" expression="compra"/>
            <assign variable="preciosVenta[n]" expression="venta"/>
            <assign variable="vencimientos[n]" expression="vence"/>
            <assign variable="nuevoN" expression="n + 1"/>
            <output expression="&quot;Producto registrado exitosamente&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
